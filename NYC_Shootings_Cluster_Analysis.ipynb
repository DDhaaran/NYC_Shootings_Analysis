    "# ===== DBSCAN CLUSTERING =====\n",
    "print(\"\\n4. DBSCAN CLUSTERING\")\n",
    "print(\"-\" * 40)\n",
    "\n",
    "# DBSCAN parameters need to be tuned\n",
    "# Using a sample to find optimal eps\n",
    "from sklearn.neighbors import NearestNeighbors\n",
    "\n",
    "# Find k-distance graph\n",
    "neighbors = NearestNeighbors(n_neighbors=5)\n",
    "neighbors_fit = neighbors.fit(X_scaled)\n",
    "distances, indices = neighbors_fit.kneighbors(X_scaled)\n",
    "distances = np.sort(distances[:, 4], axis=0)\n",
    "\n",
    "# Use median distance\n",
    "eps_value = np.median(distances)\n",
    "\n",
    "dbscan = DBSCAN(eps=eps_value, min_samples=50)\n",
    "dbscan_labels = dbscan.fit_predict(X_scaled)\n",
    "\n",
    "n_clusters_dbscan = len(set(dbscan_labels)) - (1 if -1 in dbscan_labels else 0)\n",
    "n_noise_points = list(dbscan_labels).count(-1)\n",
    "\n",
    "print(f\"Number of clusters found: {n_clusters_dbscan}\")\n",
    "print(f\"Number of noise points: {n_noise_points}\")\n",
    "\n",
    "if n_clusters_dbscan > 1 and n_noise_points < len(X_scaled) * 0.9:\n",
    "    dbscan_silhouette = silhouette_score(X_scaled, dbscan_labels)\n",
