   "source": [
    "## 5. DATA PREPROCESSING"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a copy for preprocessing\n",
    "df_processed = df.copy()\n",
    "\n",
    "print(\"=== DATA PREPROCESSING STEPS ===\")\n",
    "\n",
    "# 1. Handle missing values in categorical columns\n",
    "print(\"\\n1. Handling missing values...\")\n",
    "\n",
    "# For perpetrator demographics, replace missing with 'UNKNOWN'\n",
    "df_processed['PERP_AGE_GROUP'].fillna('UNKNOWN', inplace=True)\n",
    "df_processed['PERP_SEX'].fillna('U', inplace=True)\n",
    "df_processed['PERP_RACE'].fillna('UNKNOWN', inplace=True)\n",
    "\n",
    "# For victim demographics, they're more complete - fill with mode or UNKNOWN\n",
    "df_processed['VIC_AGE_GROUP'].fillna('UNKNOWN', inplace=True)\n",
    "df_processed['VIC_SEX'].fillna('U', inplace=True)\n",
    "df_processed['VIC_RACE'].fillna('UNKNOWN', inplace=True)\n",
    "\n",
    "# Location description\n",
    "df_processed['LOCATION_DESC'].fillna('UNKNOWN', inplace=True)\n",
    "df_processed['LOC_OF_OCCUR_DESC'].fillna('UNKNOWN', inplace=True)\n",
    "df_processed['LOC_CLASSFCTN_DESC'].fillna('UNKNOWN', inplace=True)\n",
    "\n",
    "# Remove rows with missing geographic coordinates\n",
    "df_processed = df_processed.dropna(subset=['Latitude', 'Longitude'])\n",
    "\n",
    "print(f\"   Rows after removing missing coordinates: {len(df_processed)}\")\n",
    "\n",
    "# 2. Clean age groups - remove invalid entries\n",
    "print(\"\\n2. Cleaning age groups...\")\n",
    "\n",
    "# Check for unusual age groups\n",
    "print(f\"   Unique PERP_AGE_GROUP values: {df_processed['PERP_AGE_GROUP'].unique()}\")\n",
    "print(f\"   Unique VIC_AGE_GROUP values: {df_processed['VIC_AGE_GROUP'].unique()}\")\n",
    "\n",
    "# Remove rows where perpetrator age is < 0 (impossible values like 0, 99)\n",
    "invalid_ages = ['0', '99', 'UNKNOWN']\n",
    "df_processed = df_processed[~df_processed['PERP_AGE_GROUP'].isin(invalid_ages)]\n",
    "\n",
    "print(f\"   Rows after removing invalid perpetrator ages: {len(df_processed)}\")\n",
    "\n",
    "# 3. Check coordinate validity\n",
    "print(\"\\n3. Validating geographic coordinates...\")\n",
    "# NYC latitude roughly 40.5-40.9, longitude roughly -74.3 to -73.7\n",
    "df_processed = df_processed[\n",
    "    (df_processed['Latitude'] >= 40.4) & (df_processed['Latitude'] <= 41.0) &\n",
    "    (df_processed['Longitude'] >= -74.4) & (df_processed['Longitude'] <= -73.6)\n",
    "]\n",
    "print(f\"   Rows after validating coordinates: {len(df_processed)}\")\n",
    "\n",
    "print(f\"\\nFinal processed dataset shape: {df_processed.shape}\")\n",
    "print(f\"Rows removed: {len(df) - len(df_processed)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Verify no more missing values in key columns\n",
    "print(\"\\n=== MISSING VALUES AFTER PREPROCESSING ===\")\n",
    "key_cols = ['OCCUR_DATE', 'BORO', 'PRECINCT', 'JURISDICTION_CODE', \n",
    "            'PERP_AGE_GROUP', 'PERP_SEX', 'PERP_RACE',\n",
    "            'VIC_AGE_GROUP', 'VIC_SEX', 'VIC_RACE',\n",
    "            'Latitude', 'Longitude', 'STATISTICAL_MURDER_FLAG']\n",
    "\n",
    "for col in key_cols:\n",
    "    missing = df_processed[col].isnull().sum()\n",
    "    print(f\"{col}: {missing}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. FEATURE ENGINEERING"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=== FEATURE ENGINEERING ===\")\n",
    "\n",
    "# Temporal Features\n",
    "print(\"\\n1. Creating temporal features...\")\n",
    "df_processed['TIME_PERIOD'] = pd.cut(df_processed['OCCUR_HOUR'], \n",
    "                                       bins=[0, 6, 12, 18, 24], \n",
    "                                       labels=['Night', 'Morning', 'Afternoon', 'Evening'],\n",
    "                                       include_lowest=True)\n",
    "\n",
    "# Is weekend?\n",
    "df_processed['IS_WEEKEND'] = df_processed['OCCUR_DAY_OF_WEEK'].isin([5, 6]).astype(int)\n",
    "\n",
    "# Season\n",
    "def get_season(month):\n",
    "    if month in [12, 1, 2]:\n",
    "        return 'Winter'\n",
    "    elif month in [3, 4, 5]:\n",
    "        return 'Spring'\n",
    "    elif month in [6, 7, 8]:\n",
    "        return 'Summer'\n",
    "    else:\n",
    "        return 'Fall'\n",
    "\n",
    "df_processed['SEASON'] = df_processed['OCCUR_MONTH'].apply(get_season)\n",
    "\n",
    "# 2. Geographic Features\n",
    "print(\"\\n2. Creating geographic features...\")\n",
    "\n",
    "# Distance from NYC center (40.7128, -74.0060)\n",
    "nyc_center_lat, nyc_center_lon = 40.7128, -74.0060\n",
    "df_processed['DIST_FROM_CENTER'] = np.sqrt(\n",
    "    (df_processed['Latitude'] - nyc_center_lat)**2 + \n",
    "    (df_processed['Longitude'] - nyc_center_lon)**2\n",
    ")\n",
    "\n",
    "# 3. Victim-Perpetrator Pairing\n",
    "print(\"\\n3. Creating victim-perpetrator features...\")\n",
    "\n",
    "# Same race?\n",
    "df_processed['SAME_RACE'] = (df_processed['PERP_RACE'] == df_processed['VIC_RACE']).astype(int)\n",
    "\n",
    "# Same age group?\n",
    "df_processed['SAME_AGE_GROUP'] = (df_processed['PERP_AGE_GROUP'] == df_processed['VIC_AGE_GROUP']).astype(int)\n",
    "\n",
    "# 4. Incident Type\n",
    "print(\"\\n4. Creating incident type features...\")\n",
    "df_processed['IS_MURDER'] = df_processed['STATISTICAL_MURDER_FLAG'].astype(int)\n",
    "\n",
    "# Jurisdiction type\n",
    "df_processed['JURISDICTION_TYPE'] = df_processed['JURISDICTION_CODE'].apply(\n",
    "    lambda x: 'NYPD' if x in [0, 1, 2] else 'Non-NYPD'\n",
    ")\n",
    "\n",
    "# Location type (simplified)\n",
    "def categorize_location(loc):\n",
    "    if pd.isna(loc) or loc == 'UNKNOWN':\n",
    "        return 'Unknown'\n",
    "    loc_lower = str(loc).lower()\n",
    "    if 'public' in loc_lower or 'housing' in loc_lower:\n",
    "        return 'Public Housing'\n",
    "    elif 'street' in loc_lower:\n",
    "        return 'Street'\n",
    "    elif 'apt' in loc_lower or 'apartment' in loc_lower:\n",
    "        return 'Apartment'\n",
    "    elif 'bar' in loc_lower or 'club' in loc_lower:\n",
    "        return 'Bar/Club'\n",
    "    else:\n",
    "        return 'Other'\n",
    "\n",
    "df_processed['LOCATION_TYPE'] = df_processed['LOCATION_DESC'].apply(categorize_location)\n",
    "\n",
    "print(\"\\n=== ENGINEERED FEATURES CREATED ===\")\n",
    "engineered_features = ['TIME_PERIOD', 'IS_WEEKEND', 'SEASON', 'DIST_FROM_CENTER',\n",
    "                       'SAME_RACE', 'SAME_AGE_GROUP', 'IS_MURDER', \n",
    "                       'JURISDICTION_TYPE', 'LOCATION_TYPE']\n",
    "for feat in engineered_features:\n",
    "    print(f\"✓ {feat}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display sample of engineered features\n",
    "print(\"\\nSample of engineered features:\")\n",
    "print(df_processed[engineered_features + ['Latitude', 'Longitude']].head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. ENCODING CATEGORICAL VARIABLES & FEATURE SELECTION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=== ENCODING CATEGORICAL VARIABLES ===\")\n",
    "\n",
    "# Create a copy for clustering\n",
    "df_clustering = df_processed.copy()\n",
    "\n",
    "# Label encoding for categorical variables\n",
    "label_encoders = {}\n",
    "categorical_cols = ['BORO', 'PERP_AGE_GROUP', 'PERP_SEX', 'PERP_RACE',\n",
    "                    'VIC_AGE_GROUP', 'VIC_SEX', 'VIC_RACE',\n",
    "                    'TIME_PERIOD', 'SEASON', 'LOCATION_TYPE']\n",
    "\n",
    "for col in categorical_cols:\n",
    "    le = LabelEncoder()\n",
    "    df_clustering[col + '_ENCODED'] = le.fit_transform(df_clustering[col].astype(str))\n",
    "    label_encoders[col] = le\n",
    "    print(f\"Encoded {col}: {len(le.classes_)} unique values\")\n",
    "\n",
    "# Select features for clustering\n",
    "print(\"\\n=== FEATURE SELECTION ===\")\n",
    "clustering_features = [\n",
    "    'OCCUR_HOUR', 'OCCUR_MONTH', 'OCCUR_QUARTER', 'OCCUR_DAY_OF_WEEK',\n",
    "    'OCCUR_YEAR', 'IS_WEEKEND',\n",
    "    'PRECINCT', 'JURISDICTION_CODE',\n",
    "    'Latitude', 'Longitude', 'DIST_FROM_CENTER',\n",
    "    'IS_MURDER', 'SAME_RACE', 'SAME_AGE_GROUP',\n",
    "    'BORO_ENCODED', 'PERP_AGE_GROUP_ENCODED', 'PERP_SEX_ENCODED', 'PERP_RACE_ENCODED',\n",
    "    'VIC_AGE_GROUP_ENCODED', 'VIC_SEX_ENCODED', 'VIC_RACE_ENCODED',\n",
    "    'TIME_PERIOD_ENCODED', 'SEASON_ENCODED', 'LOCATION_TYPE_ENCODED'\n",
    "]\n",
    "\n",
    "X = df_clustering[clustering_features].copy()\n",
    "\n",
    "print(f\"\\nFeatures selected for clustering: {len(clustering_features)}\")\n",
    "print(\"\\nFeature List:\")\n",
